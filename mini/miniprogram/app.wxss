page {
  background: #f2f2f7;
  font-size: 28rpx;
  color: #1c1c1e;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  padding-bottom: 140rpx;
}

/* ── 卡片 ─────────────────────────────────────────────── */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 16rpx 24rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card.block { padding: 24rpx 28rpx; }

/* ── 页面/标题 ─────────────────────────────────────────── */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  padding: 32rpx 32rpx 0;
}
.page-sub {
  font-size: 26rpx;
  color: #8e8e93;
  padding: 6rpx 32rpx 12rpx;
}

/* ── 分段条 ───────────────────────────────────────────── */
.segment-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #636366;
  margin: 28rpx 24rpx 8rpx;
}
.segment-bar::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e3e3e8;
  margin-left: 16rpx;
}

/* ── 剂量行 ───────────────────────────────────────────── */
.dose-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}
.dose-item:last-child { border-bottom: none; }
.dose-check {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #c7c7cc;
  background: transparent;
  color: #fff;
  font-size: 36rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
}
.dose-check.taken { background: #34c759; border-color: #34c759; }
.dose-info { flex: 1; min-width: 0; }
.dose-name { font-size: 30rpx; font-weight: 600; }
.dose-detail { font-size: 24rpx; color: #8e8e93; margin-top: 4rpx; }
.dose-right { text-align: right; flex-shrink: 0; }
.dose-time { font-size: 28rpx; font-weight: 600; color: #636366; }
.dose-taken {
  font-size: 22rpx;
  color: #34c759;
  font-weight: 600;
  margin-top: 4rpx;
}

/* ── 空状态 ───────────────────────────────────────────── */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #8e8e93;
}
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-hint { font-size: 24rpx; color: #b0b0b5; margin-top: 8rpx; }

/* ── 按钮 ─────────────────────────────────────────────── */
.btn-primary {
  background: #0a84ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { background: #a8cdf5; color: #fff; }
.btn-plain {
  background: #f2f2f7;
  color: #0a84ff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-plain::after { border: none; }

/* ── 表单 ─────────────────────────────────────────────── */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}
.form-row:last-child { border-bottom: none; }
.form-label { width: 190rpx; font-size: 28rpx; color: #636366; flex-shrink: 0; }
.form-value { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; }
.form-input { text-align: right; font-size: 28rpx; }
.input-inline {
  background: #f6f6f8;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
text-align: right;
  margin: 0;
}

/* ── 底部导航 ─────────────────────────────────────────── */
.nav-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e5e5ea;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.nav-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0 10rpx;
  color: #8e8e93;
  font-size: 22rpx;
}
.nav-item .nav-icon { font-size: 40rpx; display: block; margin-bottom: 4rpx; }
.nav-item.active { color: #0a84ff; font-weight: 600; }

/* ── 日历 ─────────────────────────────────────────────── */
.cal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 32rpx 8rpx;
}
.cal-btn {
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  background: #f2f2f7;
  font-size: 30rpx;
  color: #0a84ff;
}
.cal-title { font-size: 32rpx; font-weight: 700; }
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 12rpx 24rpx;
}
.cal-cell {
  width: 14.285%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}
.cal-day {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.cal-cell.today .cal-day { background: #0a84ff; color: #fff; font-weight: 700; }
.cal-cell.sel .cal-day { border: 3rpx solid #0a84ff; }
.cal-cell.dim .cal-day { color: #c7c7cc; }
.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34c759;
  margin-top: 4rpx;
}
.cal-count { font-size: 18rpx; color: #8e8e93; margin-top: 2rpx; }

/* 设置 */
.set-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f2f7;
}
.set-row:last-child { border-bottom: none; }
.set-value { color: #8e8e93; font-size: 26rpx; }
.section-title {
  font-size: 24rpx;
  color: #8e8e93;
  margin: 36rpx 32rpx 10rpx;
  font-weight: 600;
}
.hint-text { font-size: 24rpx; color: #8e8e93; line-height: 1.7; }